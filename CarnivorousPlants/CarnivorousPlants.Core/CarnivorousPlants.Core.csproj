<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableHarmony>true</EnableHarmony>
    <RootNamespace>CarnivorousPlants.Core</RootNamespace>
    <AssemblyName>CarnivorousPlants.Core</AssemblyName>

    <!-- Deployment is handled by the DeployParent target so the whole CarnivorousPlants folder is installed together. -->
    <EnableModDeploy>false</EnableModDeploy>
    <EnableModZip>false</EnableModZip>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.*" />
  </ItemGroup>

  <Target Name="DeployParent" AfterTargets="Build" Condition="'$(GameModsPath)' != ''">
    <PropertyGroup>
      <ParentDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..'))</ParentDir>
      <DeployDir>$(GameModsPath)\CarnivorousPlants</DeployDir>
    </PropertyGroup>
    <ItemGroup>
      <ContentPackFiles Include="$(ParentDir)\[CP] Carnivorous Crops\**\*" />
      <CoreFiles Include="$(TargetDir)CarnivorousPlants.Core.dll;$(MSBuildProjectDirectory)\manifest.json" />
    </ItemGroup>
    <RemoveDir Directories="$(DeployDir)" />
    <Copy SourceFiles="@(ContentPackFiles)" DestinationFiles="@(ContentPackFiles->'$(DeployDir)\[CP] Carnivorous Crops\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(CoreFiles)" DestinationFolder="$(DeployDir)\CarnivorousPlants.Core" />
  </Target>

</Project>
